<%- include('partials/header') %>
    <div class="container" style="max-width: 1100px;">
        <div class="dashboard-card-wrapper">
            <h2>Administrator Control Panel</h2>
            <div class="profile-layout">
                <aside class="profile-sidebar">
                    <div class="profile-avatar-box">
                        <% if (currentUser.avatar && currentUser.avatar.trim() !=='' ) { %>
                            <img src="<%= currentUser.avatar %>" alt="Avatar" class="profile-avatar-large">
                            <% } else { %>
                                <div class="profile-avatar-letter" style="background-color: #3742fa; color: white;">
                                    <%= currentUser.email ? currentUser.email.charAt(0).toUpperCase() : 'A' %>
                                </div>
                                <% } %>
                                    <h3 style="margin: 5px 0 0 0; color: #000;">
                                        <%= currentUser.username %>
                                    </h3>
                                    <span class="role-badge"
                                        style="background-color: #e8eaf6; color: #3742fa;">Administrator</span>
                    </div>
                    <nav class="profile-nav">
                        <button type="button" class="profile-nav-btn active"
                            onclick="showTab('profile-tab', this)">Profile Info</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('users-tab', this)">Manage Users
                            (<%= users.length %>)</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('restaurants-tab', this)">Manage
                            Restaurants (<%= restaurants.length %>)</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('reviews-tab', this)">Manage
                            Reviews (<%= reviews.length %>)</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('security-tab', this)">Security
                            Settings</button>
                    </nav>
                </aside>

                <main class="profile-content">
                    <% const serverAdminProfileError=(typeof profileError !=='undefined' && profileError) ? profileError
                        : ((typeof errorMessage !=='undefined' && errorMessage) ? errorMessage : '' ); %>
                        <% const serverAdminProfileSuccess=(typeof successMessage !=='undefined' && successMessage) ?
                            successMessage : '' ; %>

                            <div id="profile-tab" class="tab-pane active">
                                <h3>My Profile Details</h3>
                                <% if (serverAdminProfileSuccess) { %>
                                    <div
                                        style="background-color: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; padding: 10px 12px; border-radius: 6px; margin-top: 14px; font-size: 0.9rem;">
                                        <%= serverAdminProfileSuccess %>
                                    </div>
                                    <% } %>
                                        <div id="adminAvatarError" role="alert"
                                            style="display: <%= serverAdminProfileError ? 'block' : 'none' %>; background-color: #ffebee; color: #c62828; border: 1px solid #ef9a9a; padding: 10px 12px; border-radius: 6px; margin-top: 14px; font-size: 0.9rem; font-weight: 500;">
                                            <%= serverAdminProfileError %>
                                        </div>

                                        <form id="adminProfileForm" action="/profile/update" method="POST"
                                            enctype="multipart/form-data" style="margin-top: 20px;">
                                            <div class="form-group">
                                                <label>Display Name:</label>
                                                <input type="text" name="username" id="adminUsernameInput"
                                                    value="<%= currentUser.username %>" required maxlength="30">
                                            </div>
                                            <div class="form-group">
                                                <label>Avatar:</label>
                                                <input type="file" name="avatarFile" id="adminAvatarFileInput"
                                                    accept="image/jpeg,image/png,image/webp,image/*"
                                                    style="display: none;">
                                                <small style="color: #666; display: block; margin-top: 5px;">Supported
                                                    formats: JPG, PNG, WEBP. Maximum file size: 3 MB.</small>
                                                <span id="adminSelectedAvatarFileName"
                                                    style="display: block; margin-top: 6px; font-size: 0.9rem; color: #555;"></span>
                                            </div>
                                            <div
                                                style="display: flex; flex-direction: column; gap: 12px; margin-top: 15px;">
                                                <div style="display: flex; gap: 12px; width: 100%;">
                                                    <button type="button" class="btn-secondary" style="flex: 1;"
                                                        onclick="document.getElementById('adminAvatarFileInput').click();">
                                                        <%= (currentUser.avatar && currentUser.avatar.trim() !=='' )
                                                            ? 'Change Avatar' : 'Upload Avatar' %>
                                                    </button>
                                                    <% if (currentUser.avatar && currentUser.avatar.trim() !=='' ) { %>
                                                        <button type="submit" formaction="/profile/avatar/delete"
                                                            formmethod="POST" formnovalidate class="btn-danger"
                                                            style="flex: 1;"
                                                            onclick="return confirm('Are you sure you want to delete your profile photo?');">Delete
                                                            Avatar</button>
                                                        <% } %>
                                                </div>
                                                <button type="submit" class="btn-primary" style="width: 100%;">Save
                                                    Profile Changes</button>
                                            </div>
                                        </form>
                            </div>

                            <div id="users-tab" class="tab-pane">
                                <h3>User Accounts Management</h3>
                                <p style="color: #666; font-size: 0.9rem; margin-bottom: 15px;">Block user access or
                                    completely delete accounts.</p>
                                <% if (users && users.length> 0) { %>
                                    <div class="reviews-list">
                                        <% users.forEach(u=> { %>
                                            <div class="review-item"
                                                style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; border: 1px solid #ddd; padding: 12px; border-radius: 6px; background: #fff;">
                                                <div>
                                                    <strong>
                                                        <%= u.username %>
                                                    </strong> (<%= u.email %>)<br>
                                                        <span style="font-size: 0.85rem; color: #666;">
                                                            Role: <strong>
                                                                <%= u.role %>
                                                            </strong>
                                                            <% if (u.is_blocked) { %>
                                                                <span
                                                                    style="color: #ff4757; margin-left: 8px;">[BLOCKED]</span>
                                                                <% } %>
                                                        </span>
                                                </div>
                                                <% if (u.id !==currentUser.id) { %>
                                                    <div style="display: flex; gap: 8px; width: 240px;">
                                                        <form action="/admin/users/toggle/<%= u.id %>" method="POST"
                                                            style="flex: 1; margin: 0; display: flex;">
                                                            <button type="submit" class="btn-secondary"
                                                                style="width: 100%;">
                                                                <%= u.is_blocked ? 'Unblock' : 'Block' %>
                                                            </button>
                                                        </form>
                                                        <form action="/admin/users/delete/<%= u.id %>" method="POST"
                                                            style="flex: 1; margin: 0; display: flex;"
                                                            onsubmit="return confirm('Permanently delete this user from database?');">
                                                            <button type="submit" class="btn-danger"
                                                                style="width: 100%;">Delete</button>
                                                        </form>
                                                    </div>
                                                    <% } else { %>
                                                        <span style="font-size: 0.8rem; color: #888;">(Current
                                                            Admin)</span>
                                                        <% } %>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <p>No registered users found.</p>
                                        <% } %>
                            </div>

                            <div id="restaurants-tab" class="tab-pane">
                                <h3>Restaurants Management</h3>
                                <p style="color: #666; font-size: 0.9rem; margin-bottom: 15px;">Hide venues from public
                                    search or delete them permanently.</p>
                                <% if (restaurants && restaurants.length> 0) { %>
                                    <div class="reviews-list">
                                        <% restaurants.forEach(r=> { %>
                                            <div class="review-item"
                                                style="display: flex; gap: 15px; align-items: center; margin-bottom: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 6px; background: #fff;">
                                                <div
                                                    style="flex-shrink: 0; width: 110px; height: 80px; border-radius: 4px; overflow: hidden; background: #f0f0f0;">
                                                    <img src="<%= r.image ? r.image : '/images/No%20image.png' %>"
                                                        alt="<%= r.name %>"
                                                        style="width: 100%; height: 100%; object-fit: cover;">
                                                </div>
                                                <div style="flex-grow: 1; min-width: 0;">
                                                    <div
                                                        style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                                        <strong style="font-size: 1.05rem;">
                                                            <%= r.name %>
                                                        </strong>
                                                        <% if (r.is_hidden) { %>
                                                            <span
                                                                style="color: #ffa502; font-size: 0.8rem; font-weight: bold;">[HIDDEN]</span>
                                                            <% } %>
                                                    </div>
                                                    <p style="margin: 2px 0; font-size: 0.9rem; color: #555;">
                                                        <strong>Cuisine:</strong>
                                                        <%= r.cuisine %>
                                                    </p>
                                                    <p style="margin: 2px 0; font-size: 0.9rem; color: #555;">
                                                        <strong>Rating:</strong>
                                                        <%= (r.rating !==null && r.rating !==undefined && r.rating !==''
                                                            ) ? '' + Number(r.rating).toFixed(1) + ' / 5.0' : 'New' %>
                                                    </p>
                                                    <p
                                                        style="margin: 2px 0; font-size: 0.85rem; color: #555; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                        <strong>Address:</strong>
                                                        <%= r.address %>
                                                    </p>
                                                </div>
                                                <div
                                                    style="display: flex; flex-direction: column; gap: 8px; width: 170px; flex-shrink: 0;">
                                                    <form action="/admin/restaurants/toggle/<%= r.id %>" method="POST"
                                                        style="margin: 0; display: flex;">
                                                        <button type="submit" class="btn-secondary"
                                                            style="width: 100%;">
                                                            <%= r.is_hidden ? 'Show restaurant' : 'Hide restaurant' %>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/restaurants/delete/<%= r.id %>" method="POST"
                                                        style="margin: 0; display: flex;"
                                                        onsubmit="return confirm('Permanently delete this restaurant?');">
                                                        <button type="submit" class="btn-danger"
                                                            style="width: 100%;">Delete restaurant</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <p>No restaurants found.</p>
                                        <% } %>
                            </div>

                            <div id="reviews-tab" class="tab-pane">
                                <h3>Review Moderation</h3>
                                <p style="color: #666; font-size: 0.9rem; margin-bottom: 15px;">Hide inappropriate
                                    feedback or remove it entirely.</p>
                                <% if (reviews && reviews.length> 0) { %>
                                    <div class="reviews-list">
                                        <% reviews.forEach(rev=> { %>
                                            <div class="review-item"
                                                style="margin-bottom: 15px; border: 1px solid #ddd; padding: 15px; border-radius: 6px; background: #fff; position: relative;">
                                                <div
                                                    style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                                                    <div>
                                                        <strong style="font-size: 1.05rem;">
                                                            <%= rev.restaurant_name %>
                                                        </strong>
                                                        <% if (rev.is_hidden) { %>
                                                            <span
                                                                style="color: #ffa502; font-size: 0.8rem; font-weight: bold; margin-left: 8px;">[HIDDEN]</span>
                                                            <% } %>
                                                    </div>
                                                    <div class="badge-rating"
                                                        style="background: #fff8e1; border: 1px solid #ffe0b2; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; color: #b7791f;">
                                                        Rating: <%= (rev.rating !==null && rev.rating !==undefined &&
                                                            rev.rating !=='' ) ? Number(rev.rating).toFixed(1) : 'New'
                                                            %> / 5.0
                                                    </div>
                                                </div>
                                                <p style="margin: 4px 0; font-size: 0.9rem; color: #555;">
                                                    <strong>Author:</strong>
                                                    <%= rev.username %>
                                                </p>
                                                <p style="margin: 4px 0; font-size: 0.9rem; color: #555;">
                                                    <strong>Date:</strong>
                                                    <%= rev.created_at ? new
                                                        Date(rev.created_at).toLocaleDateString('en-GB') : 'Unknown' %>
                                                </p>
                                                <p style="margin: 6px 0 12px 0; font-size: 0.95rem; color: #222;">
                                                    <strong>Comment:</strong> "<%= rev.comment %>"</p>
                                                <div class="review-actions"
                                                    style="display: flex; gap: 8px; width: 100%;">
                                                    <form action="/admin/reviews/toggle/<%= rev.id %>" method="POST"
                                                        style="flex: 1; margin: 0; display: flex;">
                                                        <button type="submit" class="btn-secondary"
                                                            style="width: 100%;">
                                                            <%= rev.is_hidden ? 'Show review' : 'Hide review' %>
                                                        </button>
                                                    </form>
                                                    <form action="/admin/reviews/delete/<%= rev.id %>" method="POST"
                                                        style="flex: 1; margin: 0; display: flex;"
                                                        onsubmit="return confirm('Permanently delete this review?');">
                                                        <button type="submit" class="btn-danger"
                                                            style="width: 100%;">Delete review</button>
                                                    </form>
                                                </div>
                                            </div>
                                            <% }) %>
                                    </div>
                                    <% } else { %>
                                        <p>No reviews submitted yet.</p>
                                        <% } %>
                            </div>

                            <div id="security-tab" class="tab-pane">
                                <h3>Admin Security Settings</h3>
                                <form action="/profile/security" method="POST" class="security-form"
                                    style="margin-top: 15px;">
                                    <div class="form-group">
                                        <label>Admin Email:</label>
                                        <input type="email" value="<%= currentUser.email %>" disabled
                                            style="background-color: #e9ecef; cursor: not-allowed;">
                                    </div>
                                    <div class="form-group">
                                        <label>New Password:</label>
                                        <input type="password" name="newPassword" placeholder="Enter new admin password"
                                            required>
                                    </div>
                                    <button type="submit" class="btn-primary">Update Security Settings</button>
                                </form>
                                <hr style="margin: 10px 0; border: none; border-top: 1px solid #dcdde1;">
                                <div
                                    style="background: #fff5f5; border: 1px solid #ff4757; padding: 20px; border-radius: 8px;">
                                    <h4 style="margin-top: 0; color: #ff4757;">Terminate Session</h4>
                                    <p style="font-size: 0.9rem; color: #666; margin-bottom: 15px;">Log out of your Food
                                        Advisor account on this device.</p>
                                    <a href="/logout" class="btn-danger">Log Out from Account</a>
                                </div>
                            </div>
                </main>
            </div>
        </div>
    </div>

    <script>
        const MAX_ADMIN_AVATAR_BYTES = 3 * 1024 * 1024; // 3 MB
        const adminAvatarFileInput = document.getElementById('adminAvatarFileInput');
        const adminSelectedAvatarFileName = document.getElementById('adminSelectedAvatarFileName');
        const adminAvatarError = document.getElementById('adminAvatarError');
        const adminProfileForm = document.getElementById('adminProfileForm');
        const adminUsernameInput = document.getElementById('adminUsernameInput');

        function validateAdminUsernameRule(rawUsername) {
            const value = (rawUsername || '').trim();
            if (!value) {
                return 'Username is required.';
            }
            if (value.length > 30) {
                return 'Username must be 30 characters or fewer.';
            }
            if (!/^[\p{L}]/u.test(value)) {
                return 'Username cannot start with a number or symbol.';
            }
            return '';
        }

        function showAdminAvatarError(message) {
            if (!adminAvatarError) return;
            adminAvatarError.textContent = message;
            adminAvatarError.style.display = message ? 'block' : 'none';
        }

        function validateAdminAvatarFile(file) {
            if (!file) return true;
            if (file.type && !file.type.startsWith('image/')) {
                showAdminAvatarError('Only image files are allowed.');
                return false;
            }
            if (file.size > MAX_ADMIN_AVATAR_BYTES) {
                const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                showAdminAvatarError(`Avatar image size (${sizeMb} MB) exceeds the 3 MB limit.`);
                return false;
            }
            showAdminAvatarError('');
            return true;
        }

        if (adminUsernameInput) {
            adminUsernameInput.addEventListener('input', () => {
                if (adminAvatarError && adminAvatarError.style.display === 'block') {
                    const err = validateAdminUsernameRule(adminUsernameInput.value);
                    showAdminAvatarError(err);
                }
            });
        }

        if (adminAvatarFileInput) {
            adminAvatarFileInput.addEventListener('change', () => {
                const file = adminAvatarFileInput.files && adminAvatarFileInput.files[0];
                if (!file) {
                    if (adminSelectedAvatarFileName) adminSelectedAvatarFileName.textContent = '';
                    showAdminAvatarError('');
                    return;
                }
                if (!validateAdminAvatarFile(file)) {
                    adminAvatarFileInput.value = '';
                    if (adminSelectedAvatarFileName) adminSelectedAvatarFileName.textContent = '';
                    return;
                }
                if (adminSelectedAvatarFileName) {
                    const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
                    adminSelectedAvatarFileName.textContent = `Selected file: ${file.name} (${sizeMb} MB)`;
                }
            });
        }

        if (adminProfileForm) {
            adminProfileForm.addEventListener('submit', (event) => {
                const submitter = event.submitter;
                if (submitter && submitter.getAttribute('formaction') === '/profile/avatar/delete') {
                    showAdminAvatarError('');
                    return;
                }

                const usernameErr = adminUsernameInput ? validateAdminUsernameRule(adminUsernameInput.value) : '';
                if (usernameErr) {
                    event.preventDefault();
                    showAdminAvatarError(usernameErr);
                    if (adminUsernameInput) adminUsernameInput.focus();
                    return;
                }

                if (adminUsernameInput) {
                    adminUsernameInput.value = adminUsernameInput.value.trim();
                }

                const file = adminAvatarFileInput && adminAvatarFileInput.files && adminAvatarFileInput.files[0];
                if (file && !validateAdminAvatarFile(file)) {
                    event.preventDefault();
                }
            });
        }

        function showTab(tabId, btn) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.profile-nav-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabId).classList.add('active');
            btn.classList.add('active');
        }
    </script>
    <%- include('partials/footer') %>