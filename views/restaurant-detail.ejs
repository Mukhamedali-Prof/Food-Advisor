<%- include('partials/header') %>
    <div class="container">
        <div class="dashboard-card-wrapper">
            <div class="restaurant-detail-header">
                <div class="detail-image-container">
                    <div class="detail-image-wrapper">
                        <img src="<%= restaurant.image ? restaurant.image : '/images/No%20image.png' %>"
                            alt="<%= restaurant.name %>" class="detail-thumb">
                    </div>
                </div>
                <div class="detail-info">
                    <h2>
                        <%= restaurant.name %>
                    </h2>
                    <div class="meta-tags">
                        <span class="badge-cuisine">Cuisine: <%= restaurant.cuisine %></span>
                        <span class="badge-rating">
                            Rating: <%= (restaurant.rating !==null && restaurant.rating !==undefined &&
                                restaurant.rating !=='' ) ? Number(restaurant.rating).toFixed(1) : 'New' %> / 5.0
                        </span>
                    </div>
                    <div class="info-row">
                        <p><strong>Address:</strong>
                            <%= restaurant.address %>
                        </p>
                    </div>
                    <div class="info-row">
                        <p><strong>Working Hours:</strong> 10:00 AM - 11:00 PM</p>
                    </div>
                    <% if (restaurant.description) { %>
                        <div class="info-row">
                            <p><strong>Description:</strong>
                                <%= restaurant.description %>
                            </p>
                        </div>
                        <% } else { %>
                            <div class="info-row">
                                <p><em>No description provided yet.</em></p>
                            </div>
                            <% } %>
                                <% if (typeof currentUser !=='undefined' && currentUser && currentUser.role==='customer'
                                    ) { %>
                                    <form action="/favorites/toggle/<%= restaurant.id %>" method="POST"
                                        style="display: inline-block; margin-top: 10px;">
                                        <button type="submit" class="btn-secondary"
                                            style="width: 240px; text-align: center; font-weight: bold; background: <%= isFavorite ? '#fff' : '#ffc800' %>; color: #000;">
                                            <%= isFavorite ? 'Remove from Favorites' : 'Add to Favorites' %>
                                        </button>
                                    </form>
                                    <% } %>
                </div>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="section-block">
                <h3>Table Reservation</h3>
                <% if (currentUser && currentUser.role==='customer' ) { %>
                    <form action="/restaurant/<%= restaurant.id %>/book" method="POST" class="booking-form"
                        onsubmit="return validateNewBooking(event)">
                        <div id="new-booking-error"
                            style="display: none; background: #ffebee; color: #c62828; border: 1px solid #ffcdd2; padding: 8px; border-radius: 4px; font-size: 0.85rem; margin-bottom: 10px;">
                        </div>
                        <div class="form-group">
                            <label>Date:</label>
                            <input type="date" id="new-booking-date" name="book_date" min="<%= minBookingDate %>"
                                max="<%= (() => { const d = new Date(); d.setFullYear(d.getFullYear() + 1); return d.toISOString().split('T')[0]; })() %>"
                                required class="form-control">
                        </div>
                        <div style="display: flex; gap: 10px; margin-bottom: 10px;">
                            <div class="form-group" style="flex: 1; margin: 0;">
                                <label>Start Time:</label>
                                <input type="time" id="new-booking-start" name="start_time" required
                                    class="form-control">
                            </div>
                            <div class="form-group" style="flex: 1; margin: 0;">
                                <label>End Time:</label>
                                <input type="time" id="new-booking-end" name="end_time" required class="form-control">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Guests Count:</label>
                            <input type="number" id="new-booking-guests" name="guests" min="1" max="20" value="2"
                                required class="form-control">
                        </div>
                        <button type="submit" class="btn-primary">Confirm Booking</button>
                        <% if (bookingMessage) { %>
                            <p role="status"
                                style="margin-top: 15px; padding: 10px; border-radius: 6px; background: #fff3cd; color: #856404;">
                                <%= bookingMessage %>
                            </p>
                            <% } %>
                    </form>
                    <% } else { %>
                        <p>Please <a href="/?modal=login">log in with a customer account</a> to request a reservation.
                        </p>
                        <% } %>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="section-block">
                <h3>Menu</h3>
                <% if (menuItems && menuItems.length> 0) { %>
                    <div class="favorites-grid">
                        <% menuItems.forEach(function(item) { %>
                            <% const dishImage=item.image || item.image_url || '/images/No%20image.png' ; %>
                                <div class="favorite-item" style="display: flex; align-items: flex-start; gap: 14px;">
                                    <img src="<%= dishImage %>" alt="<%= item.name %>"
                                        style="width: 110px; height: 110px; max-width: 110px; max-height: 110px; flex-shrink: 0; object-fit: cover; border-radius: 6px;">
                                    <div style="flex: 1; min-width: 0;">
                                        <h4 style="margin: 0 0 6px 0;">
                                            <%= item.name %> — $<%= Number(item.price).toFixed(2) %>
                                        </h4>
                                        <% if (item.description) { %>
                                            <p style="margin: 0;">
                                                <%= item.description %>
                                            </p>
                                            <% } %>
                                    </div>
                                </div>
                                <% }) %>
                    </div>
                    <% } else { %>
                        <p>This restaurant has not published its menu yet.</p>
                        <% } %>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="section-block">
                <h3>Customer Reviews (<%= reviews.length %>)</h3>
                <% if (reviews && reviews.length> 0) { %>
                    <div class="reviews-list" style="display: flex; flex-direction: column; gap: 12px;">
                        <% reviews.forEach(function(rev) { %>
                            <% const rawAvatar=rev.avatar || rev.user_avatar || rev.profile_image || rev.user_image
                                || '' ; %>
                                <% const avatarSrc=(typeof rawAvatar==='string' && rawAvatar.trim() !=='' ) ? rawAvatar
                                    : '/images/No%20image.png' ; %>
                                    <div class="review-card"
                                        style="padding: 14px 16px; border: 1px solid #e1e4e8; border-radius: 8px; background: #fff; display: flex; align-items: flex-start; gap: 14px;">
                                        <img src="<%= avatarSrc %>" alt="<%= rev.username %>"
                                            style="width: 80px; height: 80px; min-width: 80px; max-width: 80px; min-height: 80px; max-height: 80px; flex-shrink: 0; object-fit: cover; border-radius: 6px; border: 1px solid #ddd; display: block;">
                                        <div style="flex: 1; min-width: 0;">
                                            <div class="review-meta"
                                                style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 8px;">
                                                <div>
                                                    <strong style="color: #2f3640;">
                                                        <%= rev.username %>
                                                    </strong>
                                                    <% if (rev.created_at) { %>
                                                        <div
                                                            style="font-size: 0.8rem; color: #8c98a4; margin-top: 2px;">
                                                            <%= new Date(rev.created_at).toLocaleDateString('en-US', {
                                                                month: 'short' , day: 'numeric' , year: 'numeric' }) %>
                                                        </div>
                                                        <% } %>
                                                </div>
                                                <span class="review-rating"
                                                    style="white-space: nowrap; font-size: 0.85rem; font-weight: bold; background: #fff8e1; padding: 3px 8px; border-radius: 6px; border: 1px solid #ffe082;">
                                                    <%= Number(rev.rating).toFixed(1) %> / 5.0
                                                </span>
                                            </div>
                                            <p class="review-comment"
                                                style="margin: 0; color: #353b48; line-height: 1.45; font-size: 0.95rem;">
                                                “<%= rev.comment %>”</p>
                                        </div>
                                    </div>
                                    <% }) %>
                    </div>
                    <% } else { %>
                        <p>No reviews yet. Be the first to share your experience!</p>
                        <% } %>

                            <% if (currentUser && currentUser.role==='customer' ) { %>
                                <% const userAlreadyReviewed=reviews.some(r=> r.user_id === currentUser.id); %>
                                    <% if (userAlreadyReviewed) { %>
                                        <p style="margin-top: 20px; color: #666; font-style: italic;">You have already
                                            shared your review for this restaurant.</p>
                                        <% } else { %>
                                            <h4 style="margin-top: 20px;">Write a Review</h4>
                                            <form action="/restaurant/<%= restaurant.id %>/review" method="POST">
                                                <div class="form-group">
                                                    <label>Rating (1 to 5):</label>
                                                    <input type="number" name="rating" min="1" max="5" required
                                                        class="form-control">
                                                </div>
                                                <div class="form-group">
                                                    <label>Comment:</label>
                                                    <textarea name="comment" rows="3" required
                                                        class="form-control"></textarea>
                                                </div>
                                                <button type="submit" class="btn-primary">Submit Review</button>
                                            </form>
                                            <% } %>
                                                <% } %>
            </div>

            <div style="margin-top: 30px;">
                <a href="/" class="btn-primary">Back to Home</a>
            </div>
        </div>
    </div>

    <script>
        function validateNewBooking(event) {
            const dateInput = document.getElementById('new-booking-date').value;
            const startTime = document.getElementById('new-booking-start').value;
            const endTime = document.getElementById('new-booking-end').value;
            const guestsInput = document.getElementById('new-booking-guests').value;
            const errorDiv = document.getElementById('new-booking-error');

            function showError(msg) {
                errorDiv.textContent = msg;
                errorDiv.style.display = 'block';
            }

            if (startTime && endTime && startTime >= endTime) {
                event.preventDefault();
                showError('End time must be later than start time.');
                return false;
            }

            const guests = parseInt(guestsInput, 10);
            if (isNaN(guests) || guests < 1 || guests > 20) {
                event.preventDefault();
                showError('Number of guests must be between 1 and 20.');
                return false;
            }

            if (dateInput) {
                const selectedDate = new Date(dateInput);
                const today = new Date();
                today.setHours(0, 0, 0, 0);
                const maxDate = new Date();
                maxDate.setFullYear(maxDate.getFullYear() + 1);
                maxDate.setHours(23, 59, 59, 999);

                if (selectedDate < today) {
                    event.preventDefault();
                    showError('Cannot select a past date.');
                    return false;
                }
                if (selectedDate > maxDate) {
                    event.preventDefault();
                    showError('Bookings can only be made up to 1 year in advance.');
                    return false;
                }
            }

            errorDiv.style.display = 'none';
            return true;
        }
    </script>
    <%- include('partials/footer') %>