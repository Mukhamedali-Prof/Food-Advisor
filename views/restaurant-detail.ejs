<%- include('partials/header') %>

    <div class="container">
        <div class="dashboard-card-wrapper">

            <div class="restaurant-detail-header">
                <div class="detail-image-container">
                    <div class="detail-image-wrapper">
                        <img src="<%= restaurant.image ? restaurant.image : '/images/No%20image.png' %>"
                            alt="<%= restaurant.name %>" class="detail-thumb">
                    </div>
                </div>

                <div class="detail-info">
                    <h2>
                        <%= restaurant.name %>
                    </h2>

                    <div class="meta-tags">
                        <span class="badge-cuisine">Cuisine: <%= restaurant.cuisine %></span>
                        <span class="badge-rating">Rating: <%= restaurant.rating || 'New' %> / 5.0</span>
                    </div>

                    <div class="info-row">
                        <p><strong>Address:</strong>
                            <%= restaurant.address %>
                        </p>
                    </div>

                    <div class="info-row">
                        <p><strong>Working Hours:</strong> 10:00 AM - 11:00 PM</p>
                    </div>

                    <% if (restaurant.description) { %>
                        <div class="info-row">
                            <p><strong>Description:</strong>
                                <%= restaurant.description %>
                            </p>
                        </div>
                        <% } else { %>
                            <div class="info-row">
                                <p><em>No description provided yet.</em></p>
                            </div>
                            <% } %>
                </div>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="section-block">
                <h3>Table Reservation</h3>
                <form action="/restaurant/<%= restaurant.id %>/book" method="POST" class="booking-form">
                    <div class="form-group">
                        <label>Date:</label>
                        <input type="date" name="book_date" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Start Time:</label>
                        <input type="time" name="start_time" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label>End Time:</label>
                        <input type="time" name="end_time" required class="form-control">
                    </div>
                    <div class="form-group">
                        <label>Guests Count:</label>
                        <input type="number" name="guests" min="1" max="20" value="2" required class="form-control">
                    </div>
                    <button type="submit" class="btn-primary">Confirm Booking</button>
                </form>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="section-block">
                <h3>Menu</h3>
                <ul>
                    <li>Signature Pasta - $18.99</li>
                    <li>Italian Bruschetta - $8.50</li>
                </ul>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #ccc;">

            <div class="section-block">
                <h3>Customer Reviews (<%= reviews.length %>)</h3>

                <% if (reviews && reviews.length> 0) { %>
                    <% reviews.forEach(function(rev) { %>
                        <div class="review-card"
                            style="border: 1px solid #eee; padding: 10px; margin-bottom: 10px; border-radius: 5px;">
                            <strong>
                                <%= rev.username %>
                            </strong> — Rating: <%= rev.rating %> / 5
                                <p>
                                    <%= rev.comment %>
                                </p>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p>No reviews yet. Be the first to share your experience!</p>
                                <% } %>

                                    <% if (currentUser && currentUser.role==='customer' ) { %>
                                        <h4 style="margin-top: 20px;">Write a Review</h4>
                                        <form action="/restaurant/<%= restaurant.id %>/review" method="POST">
                                            <div class="form-group">
                                                <label>Rating (1 to 5):</label>
                                                <input type="number" name="rating" min="1" max="5" required
                                                    class="form-control">
                                            </div>
                                            <div class="form-group">
                                                <label>Comment:</label>
                                                <textarea name="comment" rows="3" required
                                                    class="form-control"></textarea>
                                            </div>
                                            <button type="submit" class="btn-primary">Submit Review</>
                                        </form>
                                        <% } %>
            </div>

            <div style="margin-top: 30px;">
                <a href="/search" class="btn-primary">← Back to Search</a>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>