<%- include('partials/header') %>

    <div class="container" style="max-width: 1000px;">
        <div class="dashboard-card-wrapper">
            <h2>Restaurant Owner Dashboard</h2>
            <div class="profile-layout">

                <aside class="profile-sidebar">
                    <div class="profile-avatar-box">
                        <% if (currentUser.avatar && currentUser.avatar.trim() !=='' ) { %>
                            <img src="<%= currentUser.avatar %>" alt="Avatar" class="profile-avatar-large">
                            <% } else { %>
                                <div class="profile-avatar-letter">
                                    <%= currentUser.email ? currentUser.email.charAt(0) : currentUser.username.charAt(0)
                                        %>
                                </div>
                                <% } %>
                                    <h3 style="margin: 5px 0 0 0; color: #000;">
                                        <%= currentUser.username %>
                                    </h3>
                                    <span class="role-badge"> Restaurant Owner </span>
                    </div>
                    <nav class="profile-nav">
                        <button type="button"
                            class="profile-nav-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'profile-tab') ? 'active' : '' %>"
                            onclick="showTab('profile-tab', this)">Profile Info</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('restaurants-tab', this)">My
                            Restaurants</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('add-restaurant-tab', this)">Add
                            Restaurant</button>
                        <button type="button"
                            class="profile-nav-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'reservations-tab') ? 'active' : '' %>"
                            onclick="showTab('reservations-tab', this)">
                            Bookings
                            <span id="booking-notification-badge"
                                style="display: <%= (typeof unreadBookingCount !== 'undefined' && unreadBookingCount > 0) ? 'inline-block' : 'none' %>; margin-left: 6px; padding: 2px 7px; border-radius: 12px; background: #c62828; color: white; font-size: 0.8rem;">
                                <%= typeof unreadBookingCount !=='undefined' ? unreadBookingCount : 0 %>
                            </span>
                        </button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('security-tab', this)">Security
                            Settings</button>
                    </nav>
                </aside>

                <main class="profile-content">
                    <p id="booking-notification-toast" role="status" aria-live="polite"
                        style="display: none; padding: 12px; border-radius: 6px; background: #fff3cd; color: #664d03;">
                    </p>

                    <div id="profile-tab"
                        class="tab-pane <%= (typeof activeTab !== 'undefined' && activeTab === 'profile-tab') ? 'active' : '' %>">
                        <h3>Owner Profile Details</h3>
                        <form action="/profile/update" method="POST" enctype="multipart/form-data"
                            style="margin-top: 20px;">
                            <div class="form-group">
                                <label>Display Name:</label>
                                <input type="text" name="username" value="<%= currentUser.username %>" required>
                            </div>
                            <div class="form-group">
                                <label>Upload New Avatar from Device:</label>
                                <input type="file" name="avatarFile" accept="image/*"
                                    style="padding: 8px 0; border: none; background: transparent; display: block; width: 100%;">
                                <small style="color: #666; display: block; margin-top: 5px;">Supported formats: JPG,
                                    PNG, WEBP</small>
                            </div>
                            <% if (currentUser.avatar && currentUser.avatar.trim() !=='' ) { %>
                                <div class="form-group" style="margin-bottom: 15px;">
                                    <button type="submit" formaction="/profile/avatar/delete" formmethod="POST"
                                        class="btn-primary"
                                        style="background-color: #c62828; border-color: #c62828; width: 100%; text-align: center;"
                                        onclick="return confirm('Are you sure you want to delete your profile photo?');">
                                        Delete Avatar </button>
                                </div>
                                <% } %>
                                    <button type="submit" class="btn-primary">Save Profile Changes</button>
                        </form>
                    </div>

                    <div id="restaurants-tab" class="tab-pane">
                        <h3>My Managed Restaurants</h3>
                        <% if (myRestaurants && myRestaurants.length> 0) { %>
                            <div class="managed-restaurants-list">
                                <% myRestaurants.forEach(r=> { %>
                                    <div class="horizontal-restaurant-card"
                                        style="position: relative; height: auto !important; min-height: 0 !important; margin-bottom: 15px; padding: 12px 15px; <%= r.is_hidden ? 'opacity: 0.7; filter: grayscale(1);' : '' %>">

                                        <div
                                            style="position: absolute; top: 12px; right: 15px; font-size: 0.9rem; font-weight: bold; background: #fff8e1; padding: 2px 8px; border-radius: 6px; border: 1px solid #ffe082;">
                                            ⭐ <%= (r.rating !==null && r.rating !==undefined && r.rating !=='' ) ?
                                                Number(r.rating).toFixed(1) : 'New' %> / 5.0
                                        </div>

                                        <div class="restaurant-card-main"
                                            style="display: flex; align-items: flex-start; margin-bottom: 8px;">
                                            <div class="restaurant-card-img-wrapper"
                                                style="height: 95px; width: 95px; min-width: 95px;">
                                                <% if (r.image) { %>
                                                    <img src="<%= r.image %>" alt="<%= r.name %>"
                                                        class="horizontal-restaurant-img"
                                                        style="height: 95px; width: 95px; object-fit: cover;">
                                                    <% } else { %>
                                                        <img src="/images/No%20image.png" alt="No image"
                                                            class="horizontal-restaurant-img"
                                                            style="height: 95px; width: 95px; object-fit: cover;">
                                                        <% } %>
                                            </div>
                                            <div class="restaurant-card-info"
                                                style="width: 100%; margin-left: 12px; padding-right: 70px;">
                                                <h4 title="<%= r.name %>" style="margin: 0 0 4px 0;">
                                                    <%= r.name %>
                                                </h4>
                                                <% if (r.is_hidden) { %>
                                                    <p style="margin: 4px 0; font-weight: bold; color: #c62828;">Hidden
                                                        by admin</p>
                                                    <p
                                                        style="margin: 0 0 6px 0; font-size: 0.85rem; font-weight: bold;">
                                                        This restaurant is hidden from the public. Only an administrator
                                                        can make it visible again.</p>
                                                    <% } %>
                                                        <div class="managed-restaurant-details"
                                                            style="display: flex; flex-direction: column; gap: 2px;">
                                                            <p class="restaurant-card-field" style="margin: 0;">
                                                                <strong>Cuisine:</strong> <span
                                                                    class="restaurant-card-value"
                                                                    title="<%= r.cuisine %>">
                                                                    <%= r.cuisine %>
                                                                </span>
                                                            </p>
                                                            <p class="restaurant-card-field" style="margin: 0;">
                                                                <strong>Address:</strong> <span
                                                                    class="restaurant-card-value"
                                                                    title="<%= r.address %>">
                                                                    <%= r.address %>
                                                                </span>
                                                            </p>
                                                            <p class="restaurant-description" style="margin: 0;">
                                                                <strong>Description:</strong> <span
                                                                    class="restaurant-card-value"
                                                                    title="<%= r.description || '' %>">
                                                                    <%= r.description || 'No description provided yet.'
                                                                        %>
                                                                </span>
                                                            </p>
                                                        </div>
                                            </div>
                                        </div>

                                        <div class="restaurant-card-actions"
                                            style="display: flex; gap: 8px; margin-top: 6px; padding-top: 0;">
                                            <a href="/owner/restaurants/<%= r.id %>/menu"
                                                class="btn-secondary action-btn"
                                                style="flex: 1; text-align: center; text-decoration: none; padding: 6px 10px; font-size: 0.85rem;">Manage
                                                Menu</a>
                                            <a href="/owner/restaurants/<%= r.id %>/edit"
                                                class="btn-secondary action-btn"
                                                style="flex: 1; text-align: center; text-decoration: none; padding: 6px 10px; font-size: 0.85rem;">Edit
                                                Restaurant</a>
                                            <form action="/owner/restaurants/delete/<%= r.id %>" method="POST"
                                                style="margin: 0; flex: 1;"
                                                onsubmit="return confirm('Delete this restaurant? Its menu items, reviews, and favorites will also be deleted.');">
                                                <button type="submit" class="btn-secondary action-btn delete-btn"
                                                    style="width: 100%; padding: 6px 10px; font-size: 0.85rem;">Delete
                                                    Restaurant</button>
                                            </form>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <p>You haven't added any restaurants yet. Use the "Add Restaurant" tab to create one.
                                </p>
                                <% } %>
                    </div>

                    <div id="add-restaurant-tab" class="tab-pane">
                        <h3>Add New Restaurant</h3>
                        <form action="/owner/restaurants/add" method="POST" enctype="multipart/form-data"
                            style="margin-top: 15px;">
                            <div class="form-group">
                                <label>Restaurant Name:</label>
                                <input type="text" name="name" placeholder="e.g. Papa's Pizza" required>
                            </div>
                            <div class="form-group">
                                <label>Cuisine Type:</label>
                                <select name="cuisine" class="form-control"
                                    style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: Arial; background-color: #fff; cursor: pointer;"
                                    required>
                                    <option value="" disabled selected>Select a cuisine...</option>
                                    <option value="Italian">Italian</option>
                                    <option value="Japanese">Japanese</option>
                                    <option value="Chinese">Chinese</option>
                                    <option value="Mexican">Mexican</option>
                                    <option value="American">American</option>
                                    <option value="French">French</option>
                                    <option value="Indian">Indian</option>
                                    <option value="Thai">Thai</option>
                                    <option value="Korean">Korean</option>
                                    <option value="Turkish">Turkish</option>
                                    <option value="Georgian">Georgian</option>
                                    <option value="Mediterranean">Mediterranean</option>
                                    <option value="Spanish">Spanish</option>
                                    <option value="Greek">Greek</option>
                                    <option value="Vietnamese">Vietnamese</option>
                                    <option value="Middle Eastern">Middle Eastern</option>
                                    <option value="Brazilian">Brazilian</option>
                                    <option value="Seafood">Seafood</option>
                                    <option value="Steakhouse">Steakhouse</option>
                                    <option value="Fast Food">Fast Food</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Address:</label>
                                <input type="text" name="address" placeholder="e.g. Abaya st. 45" required>
                            </div>
                            <div class="form-group">
                                <label>Description:</label>
                                <textarea name="description" rows="3" placeholder="Brief description of your venue"
                                    style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: Arial;"
                                    required></textarea>
                            </div>
                            <div class="form-group">
                                <label>Restaurant Image:</label>
                                <div class="restaurant-upload-dropzone">
                                    <input type="file" name="imageFile" accept="image/*" id="fileInput"
                                        style="display: none;">
                                    <img id="restaurantImagePreview" class="restaurant-upload-preview"
                                        alt="Selected restaurant image preview">
                                    <button type="button"
                                        style="background-color: #ffc800; color: #000; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 16px;"
                                        onclick="document.getElementById('fileInput').click();">📸 Choose photo</button>
                                    <p id="restaurantImageHint" class="restaurant-upload-hint">Image preview will appear
                                        here.</p>
                                </div>
                            </div>
                            <button type="submit" class="btn-primary"
                                style="margin-top: 15px; width: 100%; padding: 12px; font-size: 16px;">Publish
                                Restaurant</button>
                        </form>
                    </div>

                    <div id="reservations-tab"
                        class="tab-pane <%= (typeof activeTab !== 'undefined' && activeTab === 'reservations-tab') ? 'active' : '' %>">
                        <h3>Restaurant Bookings</h3>

                        <% if (typeof bookings !=='undefined' && bookings && bookings.length> 0) { %>
                            <div class="managed-restaurants-list">
                                <% bookings.forEach(function(booking) { %>
                                    <div class="horizontal-restaurant-card"
                                        style="position: relative; height: auto !important; min-height: 0 !important; margin-bottom: 15px; padding: 12px 15px;">

                                        <div class="restaurant-card-main"
                                            style="display: flex; align-items: flex-start; margin-bottom: 8px;">

                                            <div class="restaurant-card-img-wrapper"
                                                style="height: 65px; width: 65px; min-width: 65px; display: flex; align-items: center; justify-content: center;">
                                                <% if (booking.customer_avatar && booking.customer_avatar.trim() !=='' )
                                                    { %>
                                                    <img src="<%= booking.customer_avatar %>" alt="Customer Avatar"
                                                        class="horizontal-restaurant-img"
                                                        style="height: 65px; width: 65px; border-radius: 50%; object-fit: cover;">
                                                    <% } else { %>
                                                        <div
                                                            style="height: 65px; width: 65px; border-radius: 50%; background: #e9ecef; color: #333; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.4rem;">
                                                            <%= booking.customer_email ?
                                                                booking.customer_email.charAt(0).toUpperCase() :
                                                                (booking.customer_name ?
                                                                booking.customer_name.charAt(0).toUpperCase() : 'U' ) %>
                                                        </div>
                                                        <% } %>
                                            </div>

                                            <div class="restaurant-card-info" style="width: 100%; margin-left: 14px;">
                                                <h4 title="<%= booking.restaurant_name %>" style="margin: 0 0 4px 0;">
                                                    <%= booking.restaurant_name %>
                                                </h4>

                                                <div class="managed-restaurant-details"
                                                    style="display: flex; flex-direction: column; gap: 2px;">
                                                    <p class="restaurant-card-field" style="margin: 0;">
                                                        <strong>Customer:</strong> <span class="restaurant-card-value">
                                                            <%= booking.customer_name %>
                                                        </span>
                                                    </p>
                                                    <p class="restaurant-card-field" style="margin: 0;"><strong>Date &
                                                            Time:</strong> <span class="restaurant-card-value">
                                                            <%= booking.booking_date %> | <%= booking.start_time %> –
                                                                    <%= booking.end_time %>
                                                        </span></p>
                                                    <p class="restaurant-card-field" style="margin: 0;"><strong>Number
                                                            of guests:</strong> <span class="restaurant-card-value">
                                                            <%= booking.guest_count %>
                                                        </span></p>
                                                    <p class="restaurant-card-field" style="margin: 0;">
                                                        <strong>Status:</strong> <span class="restaurant-card-value"
                                                            style="text-transform: capitalize; font-weight: bold; color: <%= booking.status === 'confirmed' ? '#2e7d32' : (booking.status === 'cancelled' ? '#c62828' : '#e65100') %>;">
                                                            <%= booking.status %>
                                                        </span>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="restaurant-card-actions"
                                            style="display: flex; gap: 8px; margin-top: 8px; padding-top: 0;">
                                            <% if (booking.status==='pending' ) { %>
                                                <form action="/owner/bookings/<%= booking.id %>/status" method="POST"
                                                    style="margin: 0; flex: 1;">
                                                    <input type="hidden" name="status" value="confirmed">
                                                    <button type="submit" class="btn-secondary action-btn"
                                                        style="width: 100%; background: #fff; color: #000; border: 2px solid #000; padding: 6px 10px; font-size: 0.85rem; text-align: center;">Confirm</button>
                                                </form>

                                                <form action="/owner/bookings/<%= booking.id %>/status" method="POST"
                                                    style="margin: 0; flex: 1;">
                                                    <input type="hidden" name="status" value="cancelled">
                                                    <button type="submit" class="btn-secondary action-btn"
                                                        style="width: 100%; background: #fff; color: #ff4757; border: 2px solid #ff4757; padding: 6px 10px; font-size: 0.85rem; text-align: center;">Cancel</button>
                                                </form>
                                                <% } else { %>
                                                    <form action="/owner/bookings/<%= booking.id %>/delete"
                                                        method="POST" style="margin: 0; width: 100%;"
                                                        onsubmit="return confirm('Удалить эту бронь из расписания?');">
                                                        <button type="submit"
                                                            class="btn-secondary action-btn delete-btn"
                                                            style="width: 100%; background: #fff; color: #ff4757; border: 2px solid #ff4757; padding: 6px 10px; font-size: 0.85rem; text-align: center;">Cancel
                                                            Booking</button>
                                                    </form>
                                                    <% } %>
                                        </div>

                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <div class="role-card" style="border-left-color: #ffc800;">
                                    <p>No reservations yet.</p>
                                </div>
                                <% } %>
                    </div>

                    <div id="security-tab" class="tab-pane">
                        <h3>Security & Password Settings</h3>
                        <form action="/profile/security" method="POST" class="security-form">
                            <div class="form-group">
                                <label>Account Email:</label>
                                <input type="email" value="<%= currentUser.email %>" disabled
                                    style="background-color: #e9ecef; cursor: not-allowed;">
                            </div>
                            <div class="form-group">
                                <label>New Password:</label>
                                <input type="password" name="newPassword" placeholder="Enter new password" required>
                            </div>
                            <button type="submit" class="btn-primary">Update Security Settings</button>
                        </form>
                        <hr style="margin: 10px 0; border: none; border-top: 1px solid #dcdde1;">
                        <div style="background: #fff5f5; border: 1px solid #ff4757; padding: 20px; border-radius: 8px;">
                            <h4 style="margin-top: 0; color: #ff4757;">Terminate Session</h4>
                            <p style="font-size: 0.9rem; color: #666; margin-bottom: 15px;">Log out of your Food Advisor
                                account on this device.</p>
                            <a href="/logout" class="btn-secondary"
                                style="color: #ff4757; border-color: #ff4757; display: inline-block; text-decoration: none;">Log
                                Out from Account</a>
                        </div>
                    </div>

                </main>
            </div>
        </div>
    </div>

    <script>
        const bookingBadge = document.getElementById('booking-notification-badge');
        const bookingToast = document.getElementById('booking-notification-toast');
        let previousUnreadCount = bookingBadge ? (Number(bookingBadge.textContent.trim()) || 0) : 0;

        if (previousUnreadCount > 0 && bookingToast) {
            bookingToast.textContent = `You have ${previousUnreadCount} new booking request(s).`;
            bookingToast.style.display = 'block';
        }

        function updateBookingBadge(count) {
            if (bookingBadge) {
                bookingBadge.textContent = count;
                bookingBadge.style.display = count > 0 ? 'inline-block' : 'none';
            }
        }

        async function markBookingsAsRead() {
            try {
                const response = await fetch('/owner/bookings/read-all', { method: 'POST' });
                if (response.ok) {
                    updateBookingBadge(0);
                    previousUnreadCount = 0;
                    if (bookingToast) bookingToast.style.display = 'none';
                }
            } catch (err) {
                console.error('Could not mark booking notifications as read:', err);
            }
        }

        async function checkForNewBookings() {
            try {
                const response = await fetch('/owner/bookings/notifications');
                if (!response.ok) return;
                const data = await response.json();
                const count = Number(data.unreadCount) || 0;

                if (count > previousUnreadCount && data.latest && bookingToast) {
                    bookingToast.textContent = `New booking request for ${data.latest.restaurantName} from ${data.latest.customerName}.`;
                    bookingToast.style.display = 'block';
                    window.setTimeout(() => {
                        bookingToast.style.display = 'none';
                    }, 8000);
                }
                updateBookingBadge(count);
                previousUnreadCount = count;
            } catch (err) {
                console.error('Could not check booking notifications:', err);
            }
        }

        function showTab(tabId, btn) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.profile-nav-btn').forEach(el => el.classList.remove('active'));

            const targetTab = document.getElementById(tabId);
            if (targetTab) targetTab.classList.add('active');
            if (btn) btn.classList.add('active');

            if (tabId === 'reservations-tab') {
                markBookingsAsRead();
            }
        }

        const restaurantImageInput = document.getElementById('fileInput');
        const restaurantImagePreview = document.getElementById('restaurantImagePreview');
        const restaurantImageHint = document.getElementById('restaurantImageHint');
        let restaurantImagePreviewUrl = null;

        if (restaurantImageInput && restaurantImagePreview && restaurantImageHint) {
            restaurantImageInput.addEventListener('change', () => {
                const imageFile = restaurantImageInput.files && restaurantImageInput.files[0];

                if (restaurantImagePreviewUrl) {
                    URL.revokeObjectURL(restaurantImagePreviewUrl);
                    restaurantImagePreviewUrl = null;
                }

                if (!imageFile || (imageFile.type && !imageFile.type.startsWith('image/'))) {
                    restaurantImagePreview.removeAttribute('src');
                    restaurantImagePreview.style.display = 'none';
                    restaurantImageHint.style.display = 'block';
                    return;
                }

                restaurantImagePreviewUrl = URL.createObjectURL(imageFile);
                restaurantImagePreview.src = restaurantImagePreviewUrl;
                restaurantImagePreview.style.display = 'block';
                restaurantImageHint.style.display = 'none';
            });
        }

        setInterval(checkForNewBookings, 10000);
    </script>