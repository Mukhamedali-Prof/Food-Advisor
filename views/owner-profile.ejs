<%- include('partials/header') %>
    <div class="container" style="max-width: 1000px;">
        <div class="dashboard-card-wrapper">
            <h2>Restaurant Owner Dashboard</h2>
            <div class="profile-layout">
                <aside class="profile-sidebar">
                    <div class="profile-avatar-box">
                        <% if (currentUser.avatar && currentUser.avatar.trim() !=='' ) { %>
                            <img src="<%= currentUser.avatar %>" alt="Avatar" class="profile-avatar-large">
                            <% } else { %>
                                <div class="profile-avatar-letter">
                                    <%= currentUser.email ? currentUser.email.charAt(0) : currentUser.username.charAt(0)
                                        %>
                                </div>
                                <% } %>
                                    <h3 style="margin: 5px 0 0 0; color: #000;">
                                        <%= currentUser.username %>
                                    </h3>
                                    <span class="role-badge">
                                        Restaurant Owner
                                    </span>
                    </div>
                    <nav class="profile-nav">
                        <button type="button"
                            class="profile-nav-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'profile-tab') ? 'active' : '' %>"
                            onclick="showTab('profile-tab', this)">Profile Info</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('restaurants-tab', this)">My
                            Restaurants</button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('add-restaurant-tab', this)">Add
                            Restaurant</button>
                        <button type="button"
                            class="profile-nav-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'reservations-tab') ? 'active' : '' %>"
                            onclick="showTab('reservations-tab', this)">
                            Bookings & Orders
                            <span id="booking-notification-badge"
                                style="display: <%= (typeof unreadBookingCount !== 'undefined' && unreadBookingCount > 0) ? 'inline-block' : 'none' %>; margin-left: 6px; padding: 2px 7px; border-radius: 12px; background: #c62828; color: white; font-size: 0.8rem;">
                                <%= typeof unreadBookingCount !=='undefined' ? unreadBookingCount : 0 %>
                            </span>
                        </button>
                        <button type="button" class="profile-nav-btn" onclick="showTab('security-tab', this)">Security
                            Settings</button>
                    </nav>
                </aside>
                <main class="profile-content">
                    <p id="booking-notification-toast" role="status" aria-live="polite"
                        style="display: none; padding: 12px; border-radius: 6px; background: #fff3cd; color: #664d03;">
                    </p>

                    <div id="profile-tab"
                        class="tab-pane <%= (typeof activeTab !== 'undefined' && activeTab === 'profile-tab') ? 'active' : '' %>">
                        <h3>Owner Profile Details</h3>
                        <form action="/profile/update" method="POST" enctype="multipart/form-data"
                            style="margin-top: 20px;">
                            <div class="form-group">
                                <label>Display Name:</label>
                                <input type="text" name="username" value="<%= currentUser.username %>" required>
                            </div>

                            <div class="form-group">
                                <label>Upload New Avatar from Device:</label>
                                <input type="file" name="avatarFile" accept="image/*"
                                    style="padding: 8px 0; border: none; background: transparent; display: block; width: 100%;">
                                <small style="color: #666; display: block; margin-top: 5px;">Supported formats: JPG,
                                    PNG, WEBP</small>
                            </div>

                            <% if (currentUser.avatar && currentUser.avatar.trim() !=='' ) { %>
                                <div class="form-group" style="margin-bottom: 15px;">
                                    <button type="submit" formaction="/profile/avatar/delete" formmethod="POST"
                                        class="btn-primary"
                                        style="background-color: #c62828; border-color: #c62828; width: 100%; text-align: center;"
                                        onclick="return confirm('Вы действительно хотите удалить фото профиля?');">
                                        Delete Avatar
                                    </button>
                                </div>
                                <% } %>

                                    <button type="submit" class="btn-primary">Save Profile Changes</button>
                        </form>
                    </div>

                    <div id="restaurants-tab" class="tab-pane">
                        <h3>My Managed Restaurants</h3>
                        <% if (myRestaurants && myRestaurants.length> 0) { %>
                            <div class="favorites-grid">
                                <% myRestaurants.forEach(r=> { %>
                                    <div class="favorite-item">
                                        <h4>🍽️ <%= r.name %>
                                        </h4>
                                        <p>Cuisine: <strong>
                                                <%= r.cuisine %>
                                            </strong> | Rating: ⭐ <%= r.rating %>
                                        </p>
                                        <p style="font-size: 0.85rem; color: #666;">
                                            <%= r.address %>
                                        </p>
                                        <% if (r.description) { %>
                                            <p><strong>Description:</strong>
                                                <%= r.description %>
                                            </p>
                                            <% } %>
                                                <a href="/owner/restaurants/<%= r.id %>/menu" class="btn-secondary"
                                                    style="font-size: 0.8rem; padding: 4px 10px; margin-top: 5px;">Manage
                                                    Menu</a>
                                                <a href="/owner/restaurants/<%= r.id %>/edit" class="btn-secondary"
                                                    style="font-size: 0.8rem; padding: 4px 10px; margin-top: 5px; display: inline-block; text-decoration: none;">Edit
                                                    Restaurant</a>
                                                <form action="/owner/restaurants/delete/<%= r.id %>" method="POST"
                                                    style="display: inline-block; margin-top: 5px;"
                                                    onsubmit="return confirm('Delete this restaurant? Its menu items, reviews, and favorites will also be deleted.');">
                                                    <button type="submit" class="btn-secondary"
                                                        style="font-size: 0.8rem; padding: 4px 10px; border-color: #c62828; color: #c62828;">Delete
                                                        Restaurant</button>
                                                </form>
                                    </div>
                                    <% }) %>
                            </div>
                            <% } else { %>
                                <p>You haven't added any restaurants yet. Use the "Add Restaurant" tab to create one.
                                </p>
                                <% } %>
                    </div>

                    <div id="add-restaurant-tab" class="tab-pane">
                        <h3>Add New Restaurant</h3>
                        <form action="/owner/restaurants/add" method="POST" enctype="multipart/form-data"
                            style="margin-top: 15px;">
                            <div class="form-group">
                                <label>Restaurant Name:</label>
                                <input type="text" name="name" placeholder="e.g. Papa's Pizza" required>
                            </div>
                            <div class="form-group">
                                <label>Cuisine Type:</label>
                                <input type="text" name="cuisine" placeholder="e.g. Italian, Fast Food" required>
                            </div>
                            <div class="form-group">
                                <label>Address:</label>
                                <input type="text" name="address" placeholder="e.g. Abaya st. 45" required>
                            </div>
                            <div class="form-group">
                                <label>Description:</label>
                                <textarea name="description" rows="3" placeholder="Brief description of your venue"
                                    style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: Arial;"
                                    required></textarea>
                            </div>
                            <div class="form-group">
                                <label>Restaurant Image:</label>
                                <div
                                    style="border: 2px dashed #ccc; padding: 20px; text-align: center; border-radius: 8px; background: #fafafa; margin-top: 5px;">
                                    <input type="file" name="imageFile" accept="image/*" id="fileInput"
                                        style="display: none;"
                                        onchange="document.getElementById('fileName').innerText = this.files.length > 0 ? this.files[0].name : 'Файл не выбран'">
                                    <button type="button"
                                        style="background-color: #ffc800; color: #000; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 16px;"
                                        onclick="document.getElementById('fileInput').click();">📸 Выбрать фото</button>
                                    <p id="fileName"
                                        style="margin-top: 10px; color: #666; font-size: 14px; margin-bottom: 0;">Файл
                                        не выбран</p>
                                </div>
                            </div>
                            <button type="submit" class="btn-primary"
                                style="margin-top: 15px; width: 100%; padding: 12px; font-size: 16px;">Publish
                                Restaurant</button>
                        </form>
                    </div>

                    <div id="reservations-tab"
                        class="tab-pane <%= (typeof activeTab !== 'undefined' && activeTab === 'reservations-tab') ? 'active' : '' %>">
                        <h3>Restaurant Bookings</h3>
                        <p>New requests: <strong id="booking-unread-count">
                                <%= typeof unreadBookingCount !=='undefined' ? unreadBookingCount : 0 %>
                            </strong></p>
                        <% if (typeof bookings !=='undefined' && bookings && bookings.length> 0) { %>
                            <% bookings.forEach(function(booking) { %>
                                <div class="favorite-item" style="margin-bottom: 14px;">
                                    <h4>
                                        <%= booking.restaurant_name %>
                                    </h4>
                                    <p><strong>Customer:</strong>
                                        <%= booking.customer_name %> (<%= booking.customer_email %>)
                                    </p>
                                    <p><strong>Date:</strong>
                                        <%= booking.booking_date %> | <strong>Time:</strong>
                                            <%= booking.start_time %>–<%= booking.end_time %> | <strong>Guests:</strong>
                                                    <%= booking.guest_count %>
                                    </p>
                                    <p><strong>Status:</strong>
                                        <%= booking.status %>
                                    </p>
                                    <% if (booking.status==='pending' ) { %>
                                        <form action="/owner/bookings/<%= booking.id %>/status" method="POST"
                                            style="display: inline-block;">
                                            <input type="hidden" name="status" value="confirmed">
                                            <button type="submit" class="btn-primary">Confirm Booking</button>
                                        </form>
                                        <form action="/owner/bookings/<%= booking.id %>/status" method="POST"
                                            style="display: inline-block;">
                                            <input type="hidden" name="status" value="cancelled">
                                            <button type="submit" class="btn-secondary">Decline</button>
                                        </form>
                                        <% } %>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="role-card" style="border-left-color: #ffc800;">
                                            <p>No reservations yet.</p>
                                        </div>
                                        <% } %>
                    </div>

                    <div id="security-tab" class="tab-pane">
                        <h3>Security & Password Settings</h3>
                        <form action="/profile/security" method="POST" class="security-form">
                            <div class="form-group">
                                <label>Account Email:</label>
                                <input type="email" value="<%= currentUser.email %>" disabled
                                    style="background-color: #e9ecef; cursor: not-allowed;">
                            </div>
                            <div class="form-group">
                                <label>New Password:</label>
                                <input type="password" name="newPassword" placeholder="Enter new password" required>
                            </div>
                            <button type="submit" class="btn-primary">Update Security Settings</button>
                        </form>
                        <hr style="margin: 30px 0; border: none; border-top: 1px solid #dcdde1;">
                        <div style="background: #fff5f5; border: 1px solid #ff4757; padding: 20px; border-radius: 8px;">
                            <h4 style="margin-top: 0; color: #ff4757;">Terminate Session</h4>
                            <p style="font-size: 0.9rem; color: #666; margin-bottom: 15px;">Log out of your Food Advisor
                                account on this device.</p>
                            <a href="/logout" class="btn-secondary"
                                style="color: #ff4757; border-color: #ff4757; display: inline-block; text-decoration: none;">Log
                                Out from Account</a>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>

    <script>
        const bookingBadge = document.getElementById('booking-notification-badge');
        const unreadBookingCount = document.getElementById('booking-unread-count');
        const bookingToast = document.getElementById('booking-notification-toast');
        let previousUnreadCount = bookingBadge ? (Number(bookingBadge.textContent.trim()) || 0) : 0;

        if (previousUnreadCount > 0 && bookingToast) {
            bookingToast.textContent = `You have ${previousUnreadCount} new booking request(s).`;
            bookingToast.style.display = 'block';
        }

        function updateBookingBadge(count) {
            if (bookingBadge) {
                bookingBadge.textContent = count;
                bookingBadge.style.display = count > 0 ? 'inline-block' : 'none';
            }
            if (unreadBookingCount) {
                unreadBookingCount.textContent = count;
            }
        }

        async function markBookingsAsRead() {
            try {
                const response = await fetch('/owner/bookings/read-all', { method: 'POST' });
                if (response.ok) {
                    updateBookingBadge(0);
                    previousUnreadCount = 0;
                    if (bookingToast) bookingToast.style.display = 'none';
                }
            } catch (err) {
                console.error('Could not mark booking notifications as read:', err);
            }
        }

        async function checkForNewBookings() {
            try {
                const response = await fetch('/owner/bookings/notifications');
                if (!response.ok) return;
                const data = await response.json();
                const count = Number(data.unreadCount) || 0;
                if (count > previousUnreadCount && data.latest && bookingToast) {
                    bookingToast.textContent = `New booking request for ${data.latest.restaurantName} from ${data.latest.customerName}.`;
                    bookingToast.style.display = 'block';
                    window.setTimeout(() => {
                        bookingToast.style.display = 'none';
                    }, 8000);
                }
                updateBookingBadge(count);
                previousUnreadCount = count;
            } catch (err) {
                console.error('Could not check booking notifications:', err);
            }
        }

        function showTab(tabId, btn) {
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.profile-nav-btn').forEach(el => el.classList.remove('active'));
            const targetTab = document.getElementById(tabId);
            if (targetTab) targetTab.classList.add('active');
            if (btn) btn.classList.add('active');
            if (tabId === 'reservations-tab') markBookingsAsRead();
        }

        setInterval(checkForNewBookings, 10000);
    </script>