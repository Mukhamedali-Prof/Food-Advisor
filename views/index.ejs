<%- include('partials/header') %>

    <div class="container">
        <div class="dashboard-card-wrapper">

            <div class="hero-section">
                <h2>Welcome to Food Advisor</h2>
                <p>Find the best restaurants, check menus, and read genuine customer reviews.</p>

                <form action="/search" method="GET" class="hero-search-form">
                    <div class="search-input-group">
                        <input type="text" name="query" placeholder="Search by restaurant name..." required>
                        <button type="submit" class="btn-primary">Search</button>
                    </div>
                </form>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #dcdde1;">

            <div class="section-block">
                <h3>Top Rated Restaurants</h3>
                <% if (topRestaurants && topRestaurants.length> 0) { %>
                    <div class="restaurants-grid">
                        <% topRestaurants.forEach(rest=> { %>
                            <div class="restaurant-card" onclick="window.location.href='/restaurant/<%= rest.id %>'"
                                style="cursor: pointer;">
                                <div class="restaurant-image-wrapper">
                                    <img src="<%= rest.image ? rest.image : '/images/No%20image.png' %>"
                                        alt="<%= rest.name %>" class="restaurant-thumb">
                                </div>
                                <div class="restaurant-info">
                                    <h3>
                                        <%= rest.name %>
                                    </h3>
                                    <p><strong>Cuisine:</strong>
                                        <%= rest.cuisine %>
                                    </p>
                                    <p><strong>Address:</strong>
                                        <%= rest.address %>
                                    </p>
                                    <div class="restaurant-rating">⭐ <%= rest.rating || 'New' %> / 5.0</div>
                                </div>
                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <p>No restaurants available yet.</p>
                        <% } %>
            </div>

            <hr style="margin: 30px 0; border: 0; border-top: 1px solid #dcdde1;">

            <div class="section-block">
                <h3>Recent Customer Reviews</h3>
                <% if (recentReviews && recentReviews.length> 0) { %>
                    <div class="reviews-list">
                        <% recentReviews.forEach(rev=> { %>
                            <div class="review-card">
                                <div class="review-meta">
                                    <strong>
                                        <%= rev.username %>
                                    </strong> on <em>
                                        <%= rev.restaurant_name %>
                                    </em>
                                    <span class="review-rating">⭐ <%= rev.rating %> / 5</span>
                                </div>
                                <p class="review-comment">
                                    <%= rev.comment %>
                                </p>
                            </div>
                            <% }) %>
                    </div>
                    <% } else { %>
                        <p>No reviews yet.</p>
                        <% } %>
            </div>

        </div>
    </div>

    <%- include('partials/footer') %>