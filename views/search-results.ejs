<%- include('partials/header') %>
    <div class="container">
        <div class="dashboard-card-wrapper">
            <h2>Restaurants</h2>
            <div class="search-page-layout">
                <aside class="filters-sidebar">
                    <h3>Filters</h3>
                    <form id="searchFiltersForm" action="/search" method="GET">
                        <div class="form-group">
                            <label>Restaurant Name</label>
                            <input type="text" name="query" value="<%= searchQuery %>" placeholder="Name...">
                        </div>

                        <div class="form-group">
                            <label>Cuisine / Style</label>
                            <select name="cuisine">
                                <option value="">All Cuisines</option>
                                <% const allCuisines=[ 'Italian' , 'Japanese' , 'Mexican' , 'Chinese' , 'Indian'
                                    , 'American' , 'French' , 'Thai' , 'Greek' , 'Spanish' , 'Japanese/Sushi'
                                    , 'Fast Food' , 'Bakery & Cafe' , 'Seafood' , 'Steakhouse' , 'Vegetarian / Vegan'
                                    , 'BBQ & Grill' , 'Georgian' , 'Uzbek' , 'Middle Eastern' ]; %>
                                    <% allCuisines.forEach(c=> { %>
                                        <option value="<%= c %>" <%=selectedCuisine===c ? 'selected' : '' %>><%= c %>
                                        </option>
                                        <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Location (Street)</label>
                            <select name="location">
                                <option value="">All Locations</option>
                                <% const fakeEuropeanStreets=[ 'Aethelgard Avenue' , 'Borealis Boulevard'
                                    , 'Caelum Lane' , 'Duskwood Crescent' , 'Eldoria Way' , 'Faelivor Square'
                                    , 'Glimmerfen Drive' , 'Havencrest Alley' , 'Illoria Passage' , 'Jovian Terrace'
                                    , 'Kinsale Walk' , 'LUNARIS Parkway' , 'Mirthwood Row' , 'Nebula Circle'
                                    , 'Oakhaven Loop' , 'Pendragon Close' , 'Quicksilver Strand'
                                    , 'Raventhorpe Thoroughfare' , 'Stardust Gate' , 'Zephyrion Boulevard' ]; %>
                                    <% fakeEuropeanStreets.forEach(street=> { %>
                                        <option value="<%= street %>" <%=(typeof selectedLocation !=='undefined' &&
                                            selectedLocation===street) ? 'selected' : '' %>><%= street %>
                                        </option>
                                        <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Minimum Rating</label>
                            <select name="min_rating">
                                <option value="">Any Rating</option>
                                <option value="4.0" <%=(typeof selectedMinRating !=='undefined' &&
                                    selectedMinRating==='4.0' ) ? 'selected' : '' %>>4.0 & above</option>
                                <option value="4.5" <%=(typeof selectedMinRating !=='undefined' &&
                                    selectedMinRating==='4.5' ) ? 'selected' : '' %>>4.5 & above</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Avg. Dish Price ($)</label>
                            <div style="display: flex; gap: 8px;">
                                <input type="number" id="minPriceInput" name="min_price"
                                    value="<%= typeof selectedMinPrice !== 'undefined' ? selectedMinPrice : '' %>"
                                    placeholder="Min" min="0" step="1" class="form-control" style="width: 50%;">
                                <input type="number" id="maxPriceInput" name="max_price"
                                    value="<%= typeof selectedMaxPrice !== 'undefined' ? selectedMaxPrice : '' %>"
                                    placeholder="Max" min="0" step="1" class="form-control" style="width: 50%;">
                            </div>
                            <% const initialPriceError=typeof priceError !=='undefined' ? priceError : '' ; %>
                                <div id="priceRangeError" role="alert"
                                    style="display: <%= initialPriceError ? 'block' : 'none' %>; margin-top: 8px; padding: 8px 10px; border-radius: 6px; background-color: #ffebee; border: 1px solid #ef9a9a; color: #c62828; font-size: 0.85rem; font-weight: 500;">
                                    <%= initialPriceError %>
                                </div>
                        </div>

                        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 10px;">Apply
                            Filters</button>
                    </form>
                </aside>

                <main class="results-content">
                    <% if (restaurants && restaurants.length> 0) { %>
                        <div class="managed-restaurants-list">
                            <% restaurants.forEach(r=> { %>
                                <div class="horizontal-restaurant-card"
                                    onclick="window.location.href='/restaurant/<%= r.id %>'" style="cursor: pointer;">
                                    <div
                                        style="position: absolute; top: 14px; right: 18px; font-size: 0.9rem; font-weight: bold; background: #fff8e1; padding: 2px 8px; border-radius: 6px; border: 1px solid #ffe082;">
                                        <%= (r.rating !==null && r.rating !==undefined && r.rating !=='' ) ?
                                            Number(r.rating).toFixed(1) : 'New' %> / 5.0
                                    </div>
                                    <div class="restaurant-card-main">
                                        <div class="restaurant-card-info" style="padding-right: 75px;">
                                            <h4 title="<%= r.name %>">
                                                <%= r.name %>
                                            </h4>
                                            <div class="managed-restaurant-details"
                                                style="display: flex; flex-direction: column; gap: 3px;">
                                                <p class="restaurant-card-field" style="margin: 0;">
                                                    <strong>Cuisine:</strong>
                                                    <span class="restaurant-card-value" title="<%= r.cuisine %>">
                                                        <%= r.cuisine %>
                                                    </span>
                                                </p>
                                                <p class="restaurant-card-field" style="margin: 0;">
                                                    <strong>Address:</strong>
                                                    <span class="restaurant-card-value" title="<%= r.address %>">
                                                        <%= r.address %>
                                                    </span>
                                                </p>
                                                <p class="restaurant-description" style="margin: 0;">
                                                    <strong>Description:</strong>
                                                    <span class="restaurant-card-value"
                                                        title="<%= r.description || '' %>">
                                                        <%= r.description || 'No description provided yet.' %>
                                                    </span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="restaurant-card-img-wrapper">
                                            <% if (r.image && r.image.trim() !=='' ) { %>
                                                <img src="<%= r.image %>" alt="<%= r.name %>"
                                                    class="horizontal-restaurant-img">
                                                <% } else { %>
                                                    <img src="/images/No%20image.png" alt="No image"
                                                        class="horizontal-restaurant-img">
                                                    <% } %>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% } else { %>
                            <p>No restaurants found matching your criteria.</p>
                            <% } %>
                </main>
            </div>
        </div>
    </div>

    <script>
        (function () {
            const form = document.getElementById('searchFiltersForm');
            const minInput = document.getElementById('minPriceInput');
            const maxInput = document.getElementById('maxPriceInput');
            const errorBox = document.getElementById('priceRangeError');

            if (!form || !minInput || !maxInput || !errorBox) return;

            function setPriceError(message) {
                errorBox.textContent = message || '';
                errorBox.style.display = message ? 'block' : 'none';
            }

            function validatePriceRange(changedField) {
                const minRaw = minInput.value.trim();
                const maxRaw = maxInput.value.trim();

                if (minRaw !== '' && Number(minRaw) < 0) {
                    setPriceError('Minimum price cannot be negative.');
                    return false;
                }
                if (maxRaw !== '' && Number(maxRaw) < 0) {
                    setPriceError('Maximum price cannot be negative.');
                    return false;
                }

                if (minRaw !== '' && maxRaw !== '') {
                    const minVal = Number(minRaw);
                    const maxVal = Number(maxRaw);

                    if (minVal >= maxVal) {
                        if (changedField === 'max') {
                            setPriceError('Maximum price must be greater than minimum price.');
                        } else if (changedField === 'min') {
                            setPriceError('Minimum price must be less than maximum price.');
                        } else {
                            setPriceError('Minimum price must be less than maximum price.');
                        }
                        return false;
                    }
                }

                setPriceError('');
                return true;
            }

            minInput.addEventListener('input', () => validatePriceRange('min'));
            maxInput.addEventListener('input', () => validatePriceRange('max'));

            form.addEventListener('submit', (event) => {
                if (!validatePriceRange()) {
                    event.preventDefault();
                    if (minInput.value.trim() !== '' && maxInput.value.trim() !== '' && Number(minInput.value) >= Number(maxInput.value)) {
                        maxInput.focus();
                    }
                }
            });
        })();
    </script>

    <%- include('partials/footer') %>