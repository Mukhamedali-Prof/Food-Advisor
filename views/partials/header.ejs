<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Advisor</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="site-header">
        <div class="nav-brand">
            <a href="/">Food Advisor</a>
        </div>

        <form action="/search" method="GET" class="header-search-form">
            <input type="text" name="query" placeholder="Quick search restaurants..." required>
            <button type="submit" class="header-search-btn">🔍</button>
        </form>

        <nav class="nav-links">
            <a href="/search">All Restaurants</a>
            <% if (typeof currentUser !=='undefined' && currentUser) { %>
                <% if (currentUser.role==='customer' ) { %>
                    <a href="/profile?tab=reviews">My Reviews</a>
                    <a href="/profile?tab=favorites" title="My Favorites">Favorites</a>
                    <% } %>
                        <% } %>
        </nav>

        <div class="auth-links">
            <% if (typeof currentUser !=='undefined' && currentUser) { %>
                <% const profileLink=(currentUser.role==='owner' ) ? '/owner-dashboard' : (currentUser.role==='admin'
                    ? '/admin' : '/profile' ); const hasAvatar=currentUser.avatar && currentUser.avatar.trim() !=='' &&
                    currentUser.avatar !=='null' ; const fallbackLetter=currentUser.email ?
                    currentUser.email.charAt(0).toUpperCase() : (currentUser.username ?
                    currentUser.username.charAt(0).toUpperCase() : 'U' ); const
                    adminAvatarStyle=(currentUser.role==='admin' ) ? 'background-color: #3742fa; color: #ffffff;' : '' ;
                    %>
                    <a href="<%= profileLink %>" class="user-avatar-link" title="Go to Profile">
                        <% if (hasAvatar) { %>
                            <img src="<%= currentUser.avatar %>" alt="<%= currentUser.username %>" class="user-avatar">
                            <% } else { %>
                                <div class="user-avatar-letter" style="<%= adminAvatarStyle %>">
                                    <%= fallbackLetter %>
                                </div>
                                <% } %>
                    </a>
                    <% } else { %>
                        <button type="button" class="btn-secondary" onclick="openModal('loginModal')">Login</button>
                        <button type="button" class="btn-primary" onclick="openModal('registerModal')">Register
                            Now</button>
                        <% } %>
        </div>
    </header>

    <div id="loginModal" class="modal-overlay">
        <div class="modal-content">
            <button type="button" class="modal-close" onclick="closeModal('loginModal')">&times;</button>
            <h2>System Login</h2>
            <p>Sign in to access your Food Advisor account.</p>
            <div id="loginError" class="form-error"></div>
            <form action="/login" method="POST">
                <div class="form-group">
                    <label>Email Address:</label>
                    <input type="email" name="email" required placeholder="name@example.com">
                </div>
                <div class="form-group">
                    <label>Password:</label>
                    <input type="password" name="password" required placeholder="Enter your password">
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Login</button>
                </div>
            </form>
            <div class="form-footer-link">
                <p>Don't have an account? <a href="#" onclick="switchModal('loginModal', 'registerModal')">Register
                        here</a></p>
            </div>
        </div>
    </div>

    <% const serverRegisterError=(typeof registerError !=='undefined' && registerError) ? registerError : '' ; %>
        <% const serverRegisterData=(typeof registerFormData !=='undefined' && registerFormData) ? registerFormData :
            {}; %>

            <div id="registerModal" class="modal-overlay <%= serverRegisterError ? 'active' : '' %>">
                <div class="modal-content">
                    <button type="button" class="modal-close" onclick="closeModal('registerModal')">&times;</button>
                    <h2>Create a New Account</h2>
                    <p>Join Food Advisor to discover restaurants and share reviews.</p>
                    <div id="registerError" class="form-error"
                        style="<%= serverRegisterError ? 'display: block;' : '' %>">
                        <%= serverRegisterError %>
                    </div>
                    <form action="/register" method="POST">
                        <div class="form-group">
                            <label>Username:</label>
                            <input type="text" name="username" id="registerUsernameInput"
                                value="<%= serverRegisterData.username || '' %>" required placeholder="Your name">
                        </div>
                        <div class="form-group">
                            <label>Email Address:</label>
                            <input type="email" name="email" id="registerEmailInput"
                                value="<%= serverRegisterData.email || '' %>" required placeholder="name@example.com">
                        </div>
                        <div class="form-group">
                            <label>Password:</label>
                            <input type="password" name="password" required placeholder="Create a secure password">
                        </div>
                        <div class="form-group">
                            <label>Account Role:</label>
                            <select name="role" id="registerRoleSelect">
                                <option value="customer" <%=(!serverRegisterData.role ||
                                    serverRegisterData.role==='customer' ) ? 'selected' : '' %>>Customer (Explore &
                                    Review)</option>
                                <option value="owner" <%=(serverRegisterData.role==='owner' ) ? 'selected' : '' %>
                                    >Restaurant Owner (Manage Menu & Venue)</option>
                            </select>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-primary">Register</button>
                        </div>
                    </form>
                    <div class="form-footer-link">
                        <p>Already have an account? <a href="#"
                                onclick="switchModal('registerModal', 'loginModal')">Login here</a></p>
                    </div>
                </div>
            </div>

            <script>
                function openModal(modalId) {
                    const modal = document.getElementById(modalId);
                    if (modal) modal.classList.add('active');
                }

                function closeModal(modalId) {
                    const modal = document.getElementById(modalId);
                    if (modal) modal.classList.remove('active');
                }

                function switchModal(closeId, openId) {
                    closeModal(closeId);
                    openModal(openId);
                }

                window.onclick = function (event) {
                    if (event.target.classList.contains('modal-overlay')) {
                        event.target.classList.remove('active');
                    }
                };

                window.addEventListener('DOMContentLoaded', () => {
                    const urlParams = new URLSearchParams(window.location.search);
                    const modal = urlParams.get('modal');
                    const error = urlParams.get('error');
                    const username = urlParams.get('username');
                    const email = urlParams.get('email');
                    const role = urlParams.get('role');

                    if (username !== null) {
                        const usernameInput = document.getElementById('registerUsernameInput');
                        if (usernameInput) usernameInput.value = username;
                    }
                    if (email !== null) {
                        const emailInput = document.getElementById('registerEmailInput');
                        if (emailInput) emailInput.value = email;
                    }
                    if (role !== null) {
                        const roleSelect = document.getElementById('registerRoleSelect');
                        if (roleSelect && (role === 'customer' || role === 'owner')) {
                            roleSelect.value = role;
                        }
                    }

                    if (modal) {
                        openModal(modal + 'Modal');
                        if (error) {
                            const errorDiv = document.getElementById(modal + 'Error');
                            if (errorDiv) {
                                errorDiv.textContent = error;
                                errorDiv.style.display = 'block';
                            }
                        }
                    }
                });
            </script>