<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Advisor</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <header>
        <div class="nav-brand">
            <a href="/">Food Advisor</a>
        </div>

        <nav class="nav-links">
            <a href="/restaurants">Restaurants</a>
            <% if (typeof currentUser !=='undefined' && currentUser) { %>
                <% if (currentUser.role==='owner' ) { %>
                    <a href="/owner-dashboard">Owner Dashboard</a>
                    <% } else if (currentUser.role==='admin' ) { %>
                        <a href="/admin">Admin Panel</a>
                        <% } else if (currentUser.role==='customer' ) { %>
                            <a href="/my-reviews">My Reviews</a>
                            <% } %>
                                <% } %>
        </nav>

        <div class="auth-links">
            <% if (typeof currentUser !=='undefined' && currentUser) { %>
                <a href="/logout" class="btn-logout">Logout</a>
                <% } else { %>
                    <button type="button" class="btn-login" onclick="openModal('loginModal')">Login</button>
                    <button type="button" class="btn-primary" onclick="openModal('registerModal')">Register Now</button>
                    <% } %>
        </div>
    </header>

    <div id="loginModal" class="modal-overlay">
        <div class="modal-content">
            <button type="button" class="modal-close" onclick="closeModal('loginModal')">&times;</button>
            <h2>System Login</h2>
            <p>Sign in to access your Food Advisor account.</p>

            <div id="loginError" class="form-error"></div>

            <form action="/login" method="POST">
                <div class="form-group">
                    <label>Email Address:</label>
                    <input type="email" name="email" required placeholder="name@example.com">
                </div>

                <div class="form-group">
                    <label>Password:</label>
                    <input type="password" name="password" required placeholder="Enter your password">
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-submit">Login</button>
                </div>
            </form>

            <div class="form-footer-link">
                <p>Don't have an account? <a href="#" onclick="switchModal('loginModal', 'registerModal')">Register
                        here</a></p>
            </div>
        </div>
    </div>

    <div id="registerModal" class="modal-overlay">
        <div class="modal-content">
            <button type="button" class="modal-close" onclick="closeModal('registerModal')">&times;</button>
            <h2>Create a New Account</h2>
            <p>Join Food Advisor to discover restaurants and share reviews.</p>

            <div id="registerError" class="form-error"></div>

            <form action="/register" method="POST">
                <div class="form-group">
                    <label>Username:</label>
                    <input type="text" name="username" required placeholder="Your name">
                </div>

                <div class="form-group">
                    <label>Email Address:</label>
                    <input type="email" name="email" required placeholder="name@example.com">
                </div>

                <div class="form-group">
                    <label>Password:</label>
                    <input type="password" name="password" required placeholder="Create a secure password">
                </div>

                <div class="form-group">
                    <label>Account Role:</label>
                    <select name="role">
                        <option value="customer">Customer (Explore & Review)</option>
                        <option value="owner">Restaurant Owner (Manage Menu & Venue)</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-submit">Register</button>
                </div>
            </form>

            <div class="form-footer-link">
                <p>Already have an account? <a href="#" onclick="switchModal('registerModal', 'loginModal')">Login
                        here</a></p>
            </div>
        </div>
    </div>

    <script>
        function openModal(modalId) {
            document.getElementById(modalId).classList.add('active');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        function switchModal(closeId, openId) {
            closeModal(closeId);
            openModal(openId);
        }

        window.onclick = function (event) {
            if (event.target.classList.contains('modal-overlay')) {
                event.target.classList.remove('active');
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const modal = urlParams.get('modal');
            const error = urlParams.get('error');

            if (modal) {
                openModal(modal + 'Modal');
                if (error) {
                    const errorDiv = document.getElementById(modal + 'Error');
                    if (errorDiv) {
                        errorDiv.textContent = error;
                        errorDiv.style.display = 'block';
                    }
                }
            }
        });
    </script>

    <main class="container">